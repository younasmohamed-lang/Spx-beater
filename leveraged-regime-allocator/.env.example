# ── Data sources ────────────────────────────────────────────────────────────
# FRED (Federal Reserve Economic Data) — https://fred.stlouisfed.org/docs/api/api_key.html
DATA_FRED_API_KEY=your_fred_api_key_here

# Tiingo (market data, long history) — https://api.tiingo.com
DATA_TIINGO_API_KEY=your_tiingo_api_key_here

# Local data paths (defaults work for most setups)
# DATA_CACHE_DIR=data/cache
# DATA_RAW_DIR=data/raw
# DATA_PROCESSED_DIR=data/processed

# ── Backtest ─────────────────────────────────────────────────────────────────
# In-sample window; OOS window (>= 2015-01-01) is TABU until final evaluation
# BACKTEST_START_DATE=1990-01-01
# BACKTEST_OOS_START_DATE=2015-01-01
# BACKTEST_SMA_PERIOD=200
# BACKTEST_MIN_HISTORY_DAYS=504

# ── Portfolio ────────────────────────────────────────────────────────────────
# PORTFOLIO_INITIAL_CAPITAL=10000.0
# PORTFOLIO_MIN_LEVERAGE=0.0
# PORTFOLIO_MAX_LEVERAGE=3.0
# PORTFOLIO_REBALANCE_THRESHOLD=0.05

# ── German tax model ─────────────────────────────────────────────────────────
# TAX_KAPITALERTRAGSTEUER_RATE=0.25
# TAX_SOLIDARITAETSZUSCHLAG_RATE=0.055
# TAX_TRADE_COST_EUR=1.0

# ── Live / alerts ────────────────────────────────────────────────────────────
# LIVE_TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# LIVE_TELEGRAM_CHAT_ID=your_chat_id
# LIVE_SIGNAL_HOUR_UTC=18
